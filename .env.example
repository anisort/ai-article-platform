DB_USER=pguser
DB_PASSWORD=1234

DB_AUTH_DATABASE=auth-db
DB_ARTICLES_DATABASE=articles-db
DB_LLM_DATABASE=llm-db

DATASOURCE_AUTH_URL=jdbc:postgresql://pg-auth:5432/auth-db
DATASOURCE_ARTICLES_URL=jdbc:postgresql://pg-articles:5432/articles-db
DATASOURCE_LLM_URL=jdbc:postgresql://pg-llm:5432/llm-db

SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

REDIS_HOST=redis-cache
REDIS_PORT=6379
REDIS_PASSWORD=1234
CACHE_TYPE=redis

INDEX_TYPE=hnsw
DISTANCE_TYPE=cosine_distance
INITIALIZE_SCHEMA=true

AUTH_CLIENT_ID=auth-client-articles
AUTH_CLIENT_SECRET=secret
AUTH_CLIENT_REDIRECT_URI=http://localhost:81/home
AUTH_ISSUER_URI=http://localhost:81/auth

RESOURCE_SERVER_ISSUER_URI=http://localhost:81/auth
RESOURCE_SERVER_JWK_SET_URI=http://auth:8080/oauth2/jwks

FRONTEND_URL_HOST=http://localhost:81
NGINX_HOST_PORT=81

AUTH_SERVICE_URL_INTERNAL=http://auth:8080
FILES_SERVICE_URL_INTERNAL=http://files:9090
LLM_SERVICE_URL_INTERNAL=http://llm:8090
FILES_API_URL_INTERNAL=http://files:9090/api/v1/files

GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=
GITHUB_OAUTH2_CLIENT_ID=
GITHUB_OAUTH2_CLIENT_SECRET=

VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_EMBEDDING_MODEL=text-embedding-004
GCP_STORAGE_BUCKET_NAME=book-covers-bucket

GOOGLE_APPLICATION_CREDENTIALS=/secrets/credentials.json
